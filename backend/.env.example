# Saksham Backend Configuration
# Copy this file to .env and fill in your values. NEVER commit real secrets.

# Database connection URL. REQUIRED - the app refuses to start without it.
# Production (Neon PostgreSQL) - use the pooled connection string with sslmode=require:
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/saksham?sslmode=require
# Local development against PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/saksham
# Local prototype only (SQLite): sqlite:///./saksham.db
DATABASE_URL=sqlite:///./saksham.db

# JWT secret - generate a strong random string in production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-strong-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS origins (comma separated). Frontend dev server default:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional AI LLM configuration.
# If left empty, the app uses a deterministic template explanation.
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Optional custom map tile URL (Leaftlet). Falls back to OSM demo tiles.
# MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Optional: seed on startup (1 = yes)
SEED_ON_STARTUP=1
